# Local PostgreSQL connection. Create this database before starting the API.
# Replace the username/password with your local PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/wedding_contribution
APP_NAME=Wedding Wishlist API
DEBUG=true
# REQUIRED: generate a random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=wedding-wishlist-api
JWT_AUDIENCE=wedding-wishlist-client
